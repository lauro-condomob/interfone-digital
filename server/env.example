# Copie para server/.env (na EC2: /home/ubuntu/interfone-digital/server/.env)
# e proteja com: chmod 600 server/.env
# O arquivo é carregado pelo server.js via dotenv e está no .gitignore.

# Credenciais da Twilio usadas pelo /api/turn para gerar servidores TURN temporários
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Porta do backend (em produção o supervisor já define PORT=8000)
# PORT=8000
